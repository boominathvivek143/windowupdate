{
  "name": "window-auto-update",
  "private": true,
  "version": "1.0.0",
  "main": "electron/out/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=esm --external:electron --external:bufferutil --external:utf-8-validate \"--banner:js=import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=electron/out/main.js && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron/out/preload.js",
    "start": "tsx server.ts",
    "dev:electron": "npm run build:electron && electron electron/out/main.js",
    "start:desktop": "npm run build && npm run build:electron && electron electron/out/main.js",
    "package": "electron-builder",
    "package:win": "electron-builder --win nsis",
    "package:mac": "electron-builder --mac dmg",
    "package:linux": "electron-builder --linux AppImage",
    "clean": "rm -rf dist dist-electron",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "selfsigned": "^5.5.0",
    "vite": "^8.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
